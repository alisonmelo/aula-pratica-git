# Banco de dados
MONGO_URI=mongodb+srv://seu-usuario:sua-senha@cluster.mongodb.net/seu-banco?retryWrites=true&w=majority

# JWT
JWT_SECRET=sua-chave-secreta-super-segura-aqui

# Mailtrap - SMTP para recuperação de senha
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=seu-username-mailtrap
SMTP_PASS=seu-password-mailtrap
SMTP_FROM=noreply@seusite.com

# URL do Frontend (para gerar link de redefinição)
FRONTEND_URL=http://localhost:5500/projetos-base/01-sistema-login

# Porta do servidor
PORT=3000
