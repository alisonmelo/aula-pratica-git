# =========================================
# .env.example (Pode ser comitado no Git)
# =========================================

# Conexão com o MongoDB (Exemplo de formato sem credenciais reais)
MONGO_URI=mongodb+srv://<USUARIO>:<SENHA>@<CLUSTER>.mongodb.net/<NOME_BANCO>?retryWrites=true&w=majority

# Porta do servidor backend Express
PORT=3000

# Chave secreta de alta entropia para assinatura de tokens JWT (mínimo 64 caracteres)
# Gere usando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=substitua_por_uma_chave_criptograficamente_segura_de_producao

# Configuração SMTP para e-mails (Mailtrap ou serviço de produção como Resend/SendGrid)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=seu_usuario_aqui
SMTP_PASS=sua_senha_aqui
SMTP_FROM="Sistema QA <noreply@seusite.com>"

# Domínio do Frontend para geração de links e CORS
FRONTEND_URL=http://localhost:5500/projetos-base/01-sistema-login
ALLOWED_ORIGINS=http://localhost:5500,https://alisonmelo.github.io